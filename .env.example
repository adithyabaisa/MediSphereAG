# MedSphere Connect — Environment Configuration

# ==========================================
# 1. Supabase (Database, Auth, Storage, RLS)
# ==========================================
# If omitted or left empty, MedSphere Connect automatically runs in 
# resilient local storage mode with full seed data & in-memory persistence!
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-server-side-only

# ==========================================
# 2. AI Intelligence Provider (LLM & Embeddings)
# ==========================================
# Provider-agnostic: Gemini, OpenAI, Claude, or local Ollama
AI_PROVIDER=gemini
AI_API_KEY=your-gemini-or-openai-api-key
AI_MODEL_NAME=gemini-1.5-pro

# ==========================================
# 3. Maps & Geolocation
# ==========================================
NEXT_PUBLIC_MAPBOX_TOKEN=pk.your-mapbox-token
NEXT_PUBLIC_GOOGLE_MAPS_KEY=your-google-maps-api-key

# ==========================================
# 4. Communications (SMS / Email OTP)
# ==========================================
SMS_PROVIDER=twilio
TWILIO_ACCOUNT_SID=your-sid
TWILIO_AUTH_TOKEN=your-token
TWILIO_PHONE_NUMBER=+1234567890

# ==========================================
# 5. App URL & Secrets
# ==========================================
NEXT_PUBLIC_APP_URL=http://localhost:3000
JWT_SECRET=medsphere-super-secure-production-jwt-secret-2026
