# ==========================================
# MedSphere Connect — Git Ignore Rules
# ==========================================

# 1. Environment variables & API secrets (CRITICAL)
.env
.env*.local
.env.local
.env.development.local
.env.test.local
.env.production.local
*.pem
*.key

# Preserve example template for team onboarding
!.env.example

# 2. Dependencies
node_modules/
/.pnp
.pnp.js
.yarn/cache
.yarn/unplugged
.yarn/build-state.yml
.yarn/install-state.gz
.pnp.*

# 3. Next.js build output, artifacts & cache
.next/
out/
build/
dist/

# 4. TypeScript & Vitest caches
*.tsbuildinfo
next-env.d.ts
coverage/
.vitest/

# 5. Debug and runtime logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.log

# 6. Operating System files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# 7. IDE & Editor directories
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.sublime-workspace
*.swp
*.swo

# 8. Local Supabase CLI state
supabase/.temp/
.supabase/
